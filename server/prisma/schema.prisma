datasource db {
  provider  = "postgresql"
  // Runtime traffic goes through the connection pooler (Supabase: pgbouncer on
  // port 6543). Migrations cannot: pgbouncer's transaction mode does not support
  // the session-level statements DDL needs, so `migrate deploy` uses directUrl.
  // Locally both point at the same Postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

/// A rentable unit is either a flat or a shop. The two live in separate tables,
/// so every record that hangs off one carries a nullable FK to each and exactly
/// one of them is set — enforced by a CHECK constraint per table, not by
/// application code alone.
enum RentCategory {
  FLAT
  SHOP
}

enum IdentityType {
  NID
  PASSPORT
  BIRTH_CERTIFICATE
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum IssueCategory {
  WINDOW_BROKEN
  ELECTRICITY_PROBLEM
  FAUCET_BROKEN
  WATER_LEAKAGE
  OTHER
}

enum PaymentStatus {
  PAID
  DUE
  PARTIAL
  DEDUCTED_FROM_ADVANCE
}

/// Data type of an admin-defined dynamic column (SRS 3.2.1).
enum DynamicColumnType {
  STRING
  NUMBER
  BOOLEAN
  DATE
}

model User {
  id              String  @id @default(uuid())
  fullName        String
  phone           String  @unique
  passwordHash    String
  role            Role    @default(USER)
  isPhoneVerified Boolean @default(false)
  isApproved      Boolean @default(false)

  // Profile Details
  dob            DateTime?
  familyMembers  Int          @default(1)
  identityType   IdentityType
  identityNumber String       @unique

  // Address Breakdown
  village       String
  postOffice    String
  district      String
  policeStation String
  division      String

  // Relationships
  tenancy      Tenancy?
  tickets      MaintenanceTicket[]
  messagesSent ChatMessage[]       @relation("SentMessages")
  messagesRecv ChatMessage[]       @relation("ReceivedMessages")
  // Both are evidence trails, so they outlive the account that created them:
  // the FK is nulled on delete and the actor's name is snapshotted on the row.
  meterReadings MeterReading[]
  activityLogs  ActivityLog[]

  /// Admin-defined dynamic columns (SRS 3.2.1).
  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flat {
  id         String  @id @default(uuid())
  flatNumber String  @unique
  floor      Int
  building   String  @default("Main Building")
  isOccupied Boolean @default(false)

  // Base Pricing Structure
  baseRent Float

  tenancies Tenancy[]
  invoices  Invoice[]
  tickets   MaintenanceTicket[]
  expenses  BuildingExpense[]
  meters    Meter[]

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// `userId` is unique: a user holds at most one tenancy, which is half of the
/// assignment invariant. Exactly one of `flatId` / `shopId` is set — see the
/// `tenancy_one_unit` CHECK constraint in the migration.
model Tenancy {
  id     String  @id @default(uuid())
  userId String  @unique
  flatId String?
  shopId String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat   Flat?   @relation(fields: [flatId], references: [id])
  shop   Shop?   @relation(fields: [shopId], references: [id])

  startDate      DateTime  @default(now())
  endDate        DateTime?
  advanceDeposit Float     @default(0.0)
  accumulatedDue Float     @default(0.0)
  isActive       Boolean   @default(true)

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([flatId])
  @@index([shopId])
}

/// Exactly one of `flatId` / `shopId` is set (`invoice_one_unit` CHECK).
///
/// Postgres treats NULLs as distinct in a unique index, so the two
/// `@@unique` pairs below coexist: shop invoices all have `flatId = NULL` and
/// therefore never collide on the flat index, and vice versa.
model Invoice {
  id     String  @id @default(uuid())
  flatId String?
  shopId String?
  flat   Flat?   @relation(fields: [flatId], references: [id])
  shop   Shop?   @relation(fields: [shopId], references: [id])
  month  Int // 1 - 12
  year   Int

  // Bill Breakdown. Which lines apply depends on the unit type — see
  // LINE_ITEMS in services/rent.service.ts. `flatRent` is the rent line for
  // both flats and shops.
  flatRent        Float
  electricityBill Float @default(0.0)
  waterBill       Float @default(0.0)
  internetBill    Float @default(0.0)
  utilityBill     Float @default(0.0)

  // Shop-only lines; always 0 on a flat invoice.
  serviceCharge     Float @default(0.0)
  maintenanceCharge Float @default(0.0)

  previousDue Float @default(0.0)
  totalAmount Float

  paymentStatus   PaymentStatus @default(DUE)
  paidAmount      Float         @default(0.0)
  advanceDeducted Float         @default(0.0)
  dueDate         DateTime
  paidAt          DateTime?

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flatId, month, year])
  @@unique([shopId, month, year])
  @@index([year, month])
}

/// A commercial unit. Parallel to `Flat` rather than a variant of it, so it
/// carries its own identifying fields: a trading name, a unit number and a
/// street address.
model Shop {
  id         String  @id @default(uuid())
  shopName   String
  shopNumber String  @unique
  address    String
  isOccupied Boolean @default(false)

  baseRent Float

  tenancies Tenancy[]
  invoices  Invoice[]
  tickets   MaintenanceTicket[]
  expenses  BuildingExpense[]
  meters    Meter[]

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Building-wide when both FKs are null; otherwise attributed to one unit.
model BuildingExpense {
  id          String   @id @default(uuid())
  flatId      String?
  shopId      String?
  flat        Flat?    @relation(fields: [flatId], references: [id])
  shop        Shop?    @relation(fields: [shopId], references: [id])
  category    String // e.g. "Electricity", "Water Maintenance", "Internet Trunk"
  amount      Float
  description String?
  expenseDate DateTime @default(now())

  customFields Json @default("{}")

  createdAt DateTime @default(now())

  @@index([expenseDate])
}

/// Exactly one of `flatId` / `shopId` is set (`ticket_one_unit` CHECK) — the
/// unit the reporter occupies.
model MaintenanceTicket {
  id          String        @id @default(uuid())
  userId      String
  flatId      String?
  shopId      String?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat        Flat?         @relation(fields: [flatId], references: [id])
  shop        Shop?         @relation(fields: [shopId], references: [id])
  category    IssueCategory
  description String
  imageUrl    String?
  status      TicketStatus  @default(PENDING)

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ChatMessage {
  id         String  @id @default(uuid())
  senderId   String
  receiverId String
  sender     User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  message    String
  isBot      Boolean @default(false)
  read       Boolean @default(false)

  customFields Json @default("{}")

  createdAt DateTime @default(now())

  @@index([senderId, receiverId])
}

/// An electricity meter, assignable to a flat *or* a shop — or to neither while
/// it sits in the pool waiting to be allocated (`meter_at_most_one_unit` CHECK).
///
/// A meter points at one unit at a time, which is the whole duplicate-assignment
/// guard: re-allocating an assigned meter is refused until it is unassigned. A
/// unit may carry several meters (a sub-metered shop), and the electricity line
/// on its invoice is the sum across them.
model Meter {
  id     String  @id @default(uuid())
  flatId String?
  shopId String?
  flat   Flat?   @relation(fields: [flatId], references: [id], onDelete: SetNull)
  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: SetNull)

  meterName   String
  meterNumber String @unique

  /// The live dial. `previousReading` is the value it held before the most
  /// recent reading was recorded, so a month's consumption is their difference.
  currentReading  Float @default(0)
  previousReading Float @default(0)

  /// Tariff per unit. Null means "use the category default" — 10 for a flat,
  /// 15 for a shop (DEFAULT_PER_UNIT in services/meter.service.ts) — so a meter
  /// that has never been overridden follows the default even after it moves
  /// between categories.
  perUnitRate Float?

  isActive Boolean @default(true)

  readings MeterReading[]

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([flatId])
  @@index([shopId])
}

/// One row per meter per billing month: the evidence behind an electricity
/// charge, and the source of the meter report (SRS 3.2.9).
///
/// Corrections overwrite the row rather than appending a second one for the
/// same month — the month has one true closing reading — and every correction
/// is written to `ActivityLog` with its before/after values, so the audit trail
/// is complete without duplicating billing rows.
model MeterReading {
  id      String @id @default(uuid())
  meterId String
  meter   Meter  @relation(fields: [meterId], references: [id], onDelete: Cascade)

  month Int // 1 - 12
  year  Int

  previousReading Float
  currentReading  Float
  /// currentReading − previousReading, stored so a later tariff or dial change
  /// cannot silently restate a month that has already been billed.
  unitsConsumed   Float
  perUnitRate     Float
  amount          Float

  /// Who submitted it. Nulled if the account is deleted; the name is kept.
  recordedById   String?
  recordedBy     User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByName String
  recordedByRole Role    @default(USER)

  /// Set once the reading has been billed onto an invoice.
  invoiceId String?

  customFields Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meterId, month, year])
  @@index([year, month])
}

/// Append-only record of every mutating action, by admins and users alike
/// (SRS 3.2.10). Deliberately absent from `MANAGED_TABLES`: a log the Data
/// Control editor could rewrite would not be evidence of anything.
model ActivityLog {
  id String @id @default(uuid())

  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  actorRole Role    @default(USER)

  /// Verb, e.g. `meter.reading.update`, or `POST /api/v1/admin/flats` for the
  /// catch-all middleware entries.
  action  String
  /// Model name, e.g. `Meter` — how the log is filtered per record.
  entity  String
  entityId String?
  summary String

  /// Field-level before/after for domain events; null for generic entries.
  before Json?
  after  Json?

  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([actorId])
}

/// Metadata registry backing SRS 3.2.1 "Dynamic Database Column & Schema Management".
/// Admin-created columns are stored as keys inside each model's `customFields` JSONB
/// blob rather than as physical DDL columns, so schema extension needs no migration
/// and cannot corrupt the relational core.
model DynamicColumn {
  id           String            @id @default(uuid())
  tableName    String
  columnName   String
  label        String
  type         DynamicColumnType @default(STRING)
  required     Boolean           @default(false)
  defaultValue String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tableName, columnName])
}
