# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Database (docker compose up -d) ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/amarbari?schema=public"
# Used only by `prisma migrate` — identical to DATABASE_URL unless a connection
# pooler sits in front of Postgres. In production (Supabase) it is the direct /
# session-mode URL; see DEPLOYMENT.md.
DIRECT_URL="postgresql://postgres:password@localhost:5432/amarbari?schema=public"

# ---- Redis ----
# REDIS_OPTIONAL=true lets the API boot with an in-memory OTP/blacklist store
# when Redis is unreachable. Set to false in production.
REDIS_URL="redis://localhost:6379"
REDIS_OPTIONAL=true

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_SECONDS=604800

# ---- CORS (comma separated) ----
CORS_ORIGINS="http://localhost:5173"

# ---- OTP ----
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_WINDOW_SECONDS=60

# ---- Messaging (WhatsApp / IMO) ----
# console | ultramsg | greenapi | webhook
# "console" logs the OTP to the server console and returns it in the API
# response outside production, so registration works with no gateway.
MESSAGING_PROVIDER=console
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
# IMO and other channels are dispatched through this outbound webhook.
MESSAGING_WEBHOOK_URL=

# ---- Rate limits (per IP / 15 min; OTP per 10 min) ----
# Raise these only for automated E2E runs, never in production.
RATE_LIMIT_GENERAL=600
RATE_LIMIT_AUTH=20
RATE_LIMIT_OTP=5

# ---- Uploads ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_PUBLIC_BASE_URL=/uploads

# ---- Invoices ----
INVOICE_CURRENCY=BDT
ADMIN_SIGNATURE_NAME="AmarBari Property Management"
# Optional PNG stamped onto generated invoices; falls back to a drawn signature.
ADMIN_SIGNATURE_PATH=

# ---- Seed credentials ----
SEED_ADMIN_PHONE="+8801700000000"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_TENANT_PASSWORD="Tenant@12345"
